rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow all access for prototype / Telegram Mini App integration
    // Telegram users operate via Telegram ID rather than Firebase Auth token.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
