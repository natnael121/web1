rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check that incoming data does not contain fields that should be read-only
    function hasNoRestrictedFields() {
      return !('role' in request.resource.data) || request.resource.data.role == resource.data.role;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Authenticated users can read any user profile.
    // Users can only create/update/delete their own document.
    // Exception: Telegram customer accounts can be created without auth (shop link flow).
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Normal auth account creation
      allow create: if (isAuthenticated() && request.auth.uid == userId)
                    // Telegram customer creation (no auth, must have telegramId)
                    || (request.resource.data.role == 'customer'
                        && request.resource.data.telegramId is number
                        && request.resource.data.displayName is string);

      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Shops ─────────────────────────────────────────────────────────────────
    // Public read (catalog visible to all).
    // Any authenticated user can create a shop.
    // Only authenticated users can update/delete (owner enforcement handled in app logic).
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      // Shop statistics subcollection
      match /stats/{statId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // ── Categories ────────────────────────────────────────────────────────────
    // Public read (needed for shop catalog pages).
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Departments ───────────────────────────────────────────────────────────
    // Only authenticated users can view and manage departments.
    // (Departments contain Telegram chat IDs — should not be public.)
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Products ──────────────────────────────────────────────────────────────
    // Public read (needed for shop catalog).
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // Authenticated users can manage orders.
    // Unauthenticated Telegram users can create orders (shop order flow).
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    || (request.resource.data.shopId is string
                        && request.resource.data.customerId is string);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Customers ─────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Shop Customers ────────────────────────────────────────────────────────
    // Unauthenticated Telegram users can register as customers via shop links.
    match /shop_customers/{shopCustomerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    || (request.resource.data.role == 'customer'
                        && request.resource.data.telegramId is number
                        && request.resource.data.shopId is string);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Shop Owners ───────────────────────────────────────────────────────────
    match /shop_owners/{ownerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── CRM ───────────────────────────────────────────────────────────────────
    match /crm_contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /crm_tags/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /crm_message_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /crm_auto_tag_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Shop Links ────────────────────────────────────────────────────────────
    // Public read (links must be resolvable without auth).
    match /shop_links/{linkId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Promotions ────────────────────────────────────────────────────────────
    match /promotions/{promotionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Analytics ─────────────────────────────────────────────────────────────
    match /analytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── System config ─────────────────────────────────────────────────────────
    match /system/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Default: deny everything not explicitly covered ───────────────────────
    // NOTE: The old catch-all /{document=**} with public write has been REMOVED
    // to prevent unauthorized data writes. All collections are explicitly listed above.
  }
}
